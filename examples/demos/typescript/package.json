{
  "name": "@converge/demo-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "A Converge worker written in TypeScript — a tsproject composer + account/bucket leaves on the same broker/proto the Go workers use.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen": "PATH=\"$PWD/node_modules/.bin:$PATH\" go run -C ../../.. ./cmd/gen-types -manifests 'examples/demos/typescript/testfixtures/*.kind.json' -ts-out examples/demos/typescript/src/gen -gojsonschema-version v0.19.0",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/worker.js"
  },
  "dependencies": {
    "@converge/worker-sdk": "file:../../../sdk-ts"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.6.0"
  }
}
