{
  "kind": "vpc",
  "kind_version": 1,
  "max_transient_attempts": 20,
  "description": "vpc/v1 ADDITIVE re-publish: adds an OPTIONAL `owner` field on top of the already-optional `tags`. Every existing v1 spec stays valid, so the publish linter classifies this BACKWARD-COMPATIBLE and AUTO-ALLOWS it in place — no new kind_version, no flag needed. Expect HTTP 200.",
  "spec_schema": {
    "additionalProperties": false,
    "properties": {
      "account_id": { "description": "Provider 12-digit account id this VPC lives in.", "maxLength": 12, "minLength": 12, "type": "string" },
      "cidr": { "description": "VPC CIDR block, e.g. 10.0.0.0/16.", "minLength": 9, "type": "string" },
      "tags": { "description": "Optional free-form tags.", "type": "object", "additionalProperties": { "type": "string" } },
      "owner": { "description": "Optional owning team (added, non-breaking).", "type": "string" }
    },
    "required": ["account_id", "cidr"],
    "type": "object"
  },
  "status_schema": {
    "additionalProperties": false,
    "properties": { "vpc_id": { "description": "Provider-issued VPC id.", "type": "string" } },
    "required": ["vpc_id"],
    "type": "object"
  },
  "reactions": [
    { "name": "work", "trigger": "specChange", "emits": ["status"] },
    { "name": "operate:enable_flow_logs", "trigger": "operation", "emits": ["operationOutput"], "verb": "enable_flow_logs" },
    { "name": "teardown", "trigger": "deleteRequested", "emits": ["finalizer"], "finalizer": "classic.demo/vpc" }
  ],
  "finalizer_name": "classic.demo/vpc",
  "orphan_grace_secs": 30
}
